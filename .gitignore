# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Configuration (contains API keys)
config.py
.env
!.env.example

# Data Files
# Raw API responses (can be large, regeneratable)
data/raw/api_responses/

# Backup files (timestamped)
data/raw/*_backup_*.csv

# Large generated data files
data/raw/videos_metadata.csv
data/raw/video_registry.csv
data/raw/channel_statistics.csv
data/raw/comments_sample.csv

# Processed/engineered data (regeneratable from raw)
data/processed/*.csv

# Keep example files and channels.csv
!*.csv.example
!data/raw/channels.csv

# Other data formats
*.xlsx
*.parquet

# Output/Generated Files
*.png
*.jpg

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
.cursor/

# OS Files
.DS_Store
Thumbs.db

